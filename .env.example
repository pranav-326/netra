# ==============================================================================
# Netra Threat Intelligence & Analysis Pipeline - Environment Configuration
# ==============================================================================

# General Project Config
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Layer 8: Data & Infrastructure (Core Storage)
# ------------------------------------------------------------------------------

# PostgreSQL (Relational Metadata & IOCs)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netra_db
POSTGRES_USER=netra_admin
POSTGRES_PASSWORD=netra_secure_password_2026

# Neo4j (Threat Actor & Infrastructure Graph)
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=netra_secret_graph_2026

# OpenSearch (Email Bodies, Forensic Logs, Vector/Fulltext Search)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=NetraStrongAdmin@2026!

# Redis (Task Queue, Cache & Pub/Sub Event Bus)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# SeaweedFS S3 store (raw EML evidence & attachments). No defaults: SeaweedFS allows
# anonymous access when no credentials exist, so it refuses to start without these.
# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=false
# Password for the SeaweedFS admin UI at http://localhost:23646 (username: admin)
SEAWEEDFS_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Future Layer Integrations (Placeholders)
# ------------------------------------------------------------------------------
# Keycloak Auth (Layer 9)
KEYCLOAK_URL=http://localhost:8080

# External Threat Intel Feeds (Layer 5/10)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
WHOISXML_API_KEY=

# ------------------------------------------------------------------------------
# Layer 5: External Threat Intelligence (AbuseIPDB free tier - 1000 checks/day)
# Get a key at https://www.abuseipdb.com/account/api. Leave blank to run Layer 5
# on the simulated dataset only; the pipeline works either way.
# ------------------------------------------------------------------------------
ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=true
ABUSEIPDB_MALICIOUS_THRESHOLD=50
ABUSEIPDB_CACHE_TTL_SECONDS=21600

# ------------------------------------------------------------------------------
# Layer 9: Authentication
# The gateway and ingestion service refuse to start without NETRA_AUTH_SECRET.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The admin (and optional analyst) account is created on the gateway's first start,
# only while no account exists. Passwords need at least 12 characters.
# ------------------------------------------------------------------------------
NETRA_AUTH_SECRET=
NETRA_TOKEN_TTL_SECONDS=28800
NETRA_ADMIN_USERNAME=admin
NETRA_ADMIN_PASSWORD=
NETRA_ANALYST_USERNAME=analyst
NETRA_ANALYST_PASSWORD=
