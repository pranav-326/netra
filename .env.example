# ==============================================================================
# Netra Threat Intelligence & Analysis Pipeline - Environment Configuration
# ==============================================================================

# General Project Config
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Layer 8: Data & Infrastructure (Core Storage)
# ------------------------------------------------------------------------------

# PostgreSQL (Relational Metadata & IOCs)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netra_db
POSTGRES_USER=netra_admin
POSTGRES_PASSWORD=netra_secure_password_2026

# Neo4j (Threat Actor & Infrastructure Graph)
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=netra_secret_graph_2026

# OpenSearch (Email Bodies, Forensic Logs, Vector/Fulltext Search)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=NetraStrongAdmin@2026!

# Redis (Task Queue, Cache & Pub/Sub Event Bus)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 (Raw EML Evidence & Malicious Attachment Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=netra_minio_admin
MINIO_ROOT_PASSWORD=netra_minio_secret_2026
MINIO_DEFAULT_BUCKETS=raw-emails,attachments,quarantine,reports
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Future Layer Integrations (Placeholders)
# ------------------------------------------------------------------------------
# Keycloak Auth (Layer 9)
KEYCLOAK_URL=http://localhost:8080

# External Threat Intel Feeds (Layer 5/10)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
WHOISXML_API_KEY=

# ------------------------------------------------------------------------------
# Layer 5: External Threat Intelligence (AbuseIPDB free tier - 1000 checks/day)
# Get a key at https://www.abuseipdb.com/account/api. Leave blank to run Layer 5
# on the simulated dataset only; the pipeline works either way.
# ------------------------------------------------------------------------------
ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=true
ABUSEIPDB_MALICIOUS_THRESHOLD=50
ABUSEIPDB_CACHE_TTL_SECONDS=21600
